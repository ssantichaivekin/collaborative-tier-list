# FRONTEND — local .env.local
# Run npm run backend; Convex CLI writes the actual development URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# BACKEND — configure in Convex, separately for development and production.
# Putting these in the frontend's .env.local does NOT configure the backend.
# Never prefix secrets with VITE_ or commit actual keys.

# Required for Firecrawl image fallback and the Web search image picker.
# Development: npx convex env set FIRECRAWL_API_KEY
# Production:  npx convex env set FIRECRAWL_API_KEY --prod
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Optional model override; this is the application's default.
# Development: npx convex env set AI_MODEL google/gemini-2.5-flash
# Production:  npx convex env set AI_MODEL google/gemini-2.5-flash --prod
AI_MODEL=google/gemini-2.5-flash

# Auto Edit requires Convex AI Gateway enabled for your team.
# No separate OPENROUTER_API_KEY is used by this application.
